# Non-secret template. Store keys through cloud secret settings; do not commit .env.
INVESTMENT_DB=/data/investment.sqlite
INVESTMENT_DATA_DIR=/data
MCP_RESOURCE_URL=https://YOUR-FREE-HOST/mcp
OAUTH_ISSUER=https://YOUR-TENANT.auth0.com/
INVESTMENT_OWNER_SUB=auth0|YOUR-OWNER-USER-ID
INVESTMENT_SCHEDULE_ENABLED=true
JQUANTS_INTERVAL_SECONDS=12.2
# Optional: subscription availability boundaries, confirmed in your dashboard.
# They must be maintained when the subscription window changes.
# JQUANTS_AVAILABLE_FROM=YYYY-MM-DD
# JQUANTS_AVAILABLE_THROUGH=YYYY-MM-DD
# JQUANTS_API_KEY: configure using the cloud secret manager, never in this file.
